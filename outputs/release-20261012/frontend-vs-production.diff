@@ -0,0 +1,14 @@
+.ville-ops{min-width:0;max-width:100%;--ops-line:#dedfd7;--ops-ink:#213d32;--ops-panel:#fff;--ops-soft:#eaf0e7;--ops-tag:#edf0e9;--ops-muted:#6d6045;--ops-link:#285e43;color:var(--ops-ink);font-size:15px;line-height:1.5;padding-bottom:75px}.ville-ops header,.ville-ops .ops-row{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}.ville-ops header h2{font-size:28px;margin:5px 0 15px}.ville-ops small{font-size:11px;letter-spacing:.03em}.ville-ops nav{display:flex;gap:8px;overflow:auto;padding:8px 0 14px}.ville-ops button{cursor:pointer;border:1px solid var(--ops-line);background:var(--ops-panel);border-radius:12px;padding:10px 15px;color:var(--ops-ink);font:inherit;min-height:44px}.ville-ops nav button[aria-current=page],.ville-ops button[type=submit]{background:#244b3c;color:white}.ville-ops button:disabled{opacity:.5;cursor:wait}.ville-ops .ops-message:empty{display:none}.ville-ops .ops-message{padding:12px;background:#fdf0d4;border-radius:10px}.ops-sync-summary{font-size:13px;color:var(--ops-muted);padding:12px 0}.ops-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,285px),1fr));gap:14px}.ops-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}.ops-kpis article{display:flex;flex-direction:column;padding:20px;background:var(--ops-soft);border-radius:16px}.ops-kpis strong{font-size:30px;font-weight:600}.ops-kpis span{font-size:13px}.ville-ops .ops-card{border:1px solid var(--ops-line);border-radius:16px;padding:18px;background:var(--ops-panel);text-align:left;overflow-wrap:anywhere}.ville-ops .ops-card h3{font-size:17px;margin:10px 0}.ville-ops .ops-card p{font-size:13px;margin:7px 0}.ops-tag{font-size:11px;background:var(--ops-tag);border-radius:20px;padding:5px 9px}.ops-warning{color:#8d4814!important;background:#fff0d8;padding:8px;border-radius:8px}.ops-detail{margin-top:20px}.ops-form{max-width:720px}.ville-ops label{display:flex;flex-direction:column;gap:6px;margin:10px 0;font-size:13px}.ville-ops input,.ville-ops select,.ville-ops textarea{width:100%;box-sizing:border-box;border:1px solid var(--ops-line);border-radius:9px;padding:12px;color:var(--ops-ink);background:var(--ops-panel);font:inherit;min-height:44px}.ville-ops textarea{min-height:80px}.ops-actions{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.ops-checklist{display:grid;gap:16px}.ops-photos{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.ops-photos a{display:flex;flex-direction:column;width:145px;color:var(--ops-link)}.ops-photos img{width:145px;height:110px;object-fit:cover;border-radius:8px}.ops-photos small{font-size:10px}.ville-ops progress{width:100%;accent-color:#325f47}.ville-ops [data-upload-queue]{background:#fff0d8;padding:5px;border-radius:8px}.ville-ops [data-upload-queue]:empty{display:none}.ville-ops [data-upload-queue] button{margin:5px}.ville-ops h3{margin-top:22px}.ville-ops a{color:var(--ops-link)}@media(max-width:650px){.ops-kpis{grid-template-columns:repeat(2,1fr)}.ops-kpis article{padding:14px}.ville-ops header h2{font-size:23px}.ville-ops nav{margin:0 -4px}.ville-ops nav button{white-space:nowrap;font-size:13px;padding:8px 11px}.ops-grid{grid-template-columns:1fr}.ville-ops .ops-card{padding:14px}}
+
+/* Embedded workspace: never inherit the public hero header's absolute layout. */
+.ville-ops>.ops-header{position:static;inset:auto;z-index:auto;padding:0;margin:0 0 12px;color:inherit;align-items:flex-start;gap:12px}
+.ville-ops>.ops-header>div{flex:1 1 220px;min-width:0}
+.ville-ops>.ops-header small{display:block}
+.ville-ops>.ops-header h2{margin:4px 0 0;line-height:1.2;overflow-wrap:anywhere}
+.ville-ops>.ops-header>button{flex:0 0 auto}
+.ville-ops>.ops-tabs{position:static;min-width:0;max-width:100%;margin:0;letter-spacing:normal;text-transform:none;overscroll-behavior-x:contain}
+.ville-ops>.ops-tabs>button{flex:0 0 auto;white-space:nowrap}
+
+/* Match the dark administrative hosts, with readable text and form surfaces. */
+.admin-body .ville-ops,.workspace .ville-ops{--ops-line:#48554b;--ops-ink:#e7eee8;--ops-panel:#1d241f;--ops-soft:#18291f;--ops-tag:#2a3c2f;--ops-muted:#c5b68d;--ops-link:#b0d7bd;color-scheme:dark}
+.ville-ops .ops-message,.ville-ops [data-upload-queue]{color:#213d32}

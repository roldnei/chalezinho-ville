{
  "buildCommand": "VILLE_RELEASE_PROFILE=whatsapp node scripts/build-finance-preview.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/stay-showcase.js": {
      "maxDuration": 60
    },
    "api/villegram.js": {
      "maxDuration": 30
    },
    "api/moments.js": {
      "maxDuration": 60
    },
    "api/promotion-banner.js": {
      "maxDuration": 60
    },
    "api/escapada-video.js": {
      "maxDuration": 60
    },
    "api/rental-page.js": {
      "maxDuration": 30,
      "includeFiles": "{casas-e-apartamentos,hospedagem}.html"
    }
  },
  "rewrites": [
    {
      "source": "/casas-e-apartamentos.html",
      "destination": "/api/rental-page"
    },
    {
      "source": "/imoveis/:slug",
      "destination": "/api/rental-page?slug=:slug"
    },
    {
      "source": "/momentos/:trip",
      "destination": "/api/moments?trip=:trip"
    },
    {
      "source": "/galeria/:chale",
      "destination": "/api/moments?chale=:chale"
    },
    {
      "source": "/sitemap-moments.xml",
      "destination": "/api/moments?sitemap=1"
    }
  ]
}

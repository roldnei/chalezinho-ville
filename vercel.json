{
  "buildCommand": "VILLE_RELEASE_PROFILE=whatsapp node scripts/build-finance-preview.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/stay-showcase.js": {
      "maxDuration": 60
    },
    "api/villegram.js": {
      "maxDuration": 30
    },
    "api/moments.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/momentos/:trip",
      "destination": "/api/moments?trip=:trip"
    },
    {
      "source": "/galeria/:chale",
      "destination": "/api/moments?chale=:chale"
    },
    {
      "source": "/sitemap-moments.xml",
      "destination": "/api/moments?sitemap=1"
    }
  ]
}
